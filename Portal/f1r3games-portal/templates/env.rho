// The F1R3Games `games` environment.
//
// Deployed by the F1R3Games service under its environment key with
// rho:registry:insertSigned:secp256k1, in the pattern of Embers'
// templates/common/insert_signed.rho: the registry value is
// (version, bundle+{*env}); a deploy re-initialises only when the
// registered version is lower than {{version}}.
//
// Every write method derives its caller from rho:deploy:data and
// rho:vault:address "fromDeployerId"; no method trusts an address passed
// as an argument. Every method answers (true, value) or (false, reason).
//
// System names are those registered on F1R3Node-Rust master.
new rl(`rho:registry:lookup`),
    rs(`rho:registry:insertSigned:secp256k1`),
    abort(`rho:execution:abort`),
    stdout(`rho:io:stdout`),
    prevEnvCh, initEnv, uriCh, env
in {
  rl!({{env_uri}}, *prevEnvCh) |
  for (@prev <- prevEnvCh) {
    match prev {
      (version, _) => {
        if (version < {{version}}) { initEnv!() }
        else { stdout!(("f1r3games env already at version", version)) }
      }
      _ => { initEnv!() }
    }
  } |

  for (<- initEnv) {
    new deployData(`rho:deploy:data`),
        blockData(`rho:block:data`),
        vaultAddress(`rho:vault:address`),
        blake2b(`rho:crypto:blake2b256Hash`),
        secpVerify(`rho:crypto:secp256k1Verify`),
        devNull(`rho:io:devNull`),
        treeHashMapCh, systemVaultCh,
        who, height, fetchAll, appendIndex, isParticipant, addParticipant,
        pull, payFromEscrow, payStipend, validTransfers, payEach, paymentsFrom
    in {
      rl!(`rho:lang:treeHashMap`, *treeHashMapCh) |
      rl!(`rho:vault:system`, *systemVaultCh) |
      for (TreeHashMap <- treeHashMapCh & @(_, SystemVault) <- systemVaultCh) {
        new m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15 in {
          TreeHashMap!("init", 2, *m1) | TreeHashMap!("init", 2, *m2) |
          TreeHashMap!("init", 2, *m3) | TreeHashMap!("init", 2, *m4) |
          TreeHashMap!("init", 2, *m5) | TreeHashMap!("init", 2, *m6) |
          TreeHashMap!("init", 2, *m7) | TreeHashMap!("init", 2, *m8) |
          TreeHashMap!("init", 2, *m9) | TreeHashMap!("init", 2, *m10) |
          TreeHashMap!("init", 2, *m11) | TreeHashMap!("init", 2, *m12) |
          TreeHashMap!("init", 2, *m13) | TreeHashMap!("init", 1, *m14) |
          TreeHashMap!("init", 2, *m15) |
          for (@profiles <- m1 & @gameMap <- m2 & @instances <- m3 &
               @gameIndex <- m4 & @plays <- m5 & @bodies <- m6 &
               @playIndex <- m7 & @invites <- m8 & @sponsors <- m9 &
               @escrows <- m10 & @counts <- m11 & @seen <- m12 &
               @contacts <- m13 & @sponsorIndex <- m14 & @payments <- m15) {

            // ---------------------------------------------------- helpers

            // (caller address, deploy timestamp, deployerId)
            contract who(ret) = {
              new ddCh, aCh in {
                deployData!(*ddCh) |
                for (@ts, @did, _ <- ddCh) {
                  vaultAddress!("fromDeployerId", did, *aCh) |
                  for (@address <- aCh) { ret!(address, ts, did) }
                }
              }
            } |

            contract height(ret) = {
              new bdCh in {
                blockData!(*bdCh) |
                for (@n, _, _ <- bdCh) { ret!(n) }
              }
            } |

            // Fetch the values of `keys` from `map`, in order.
            contract fetchAll(@map, @keys, @acc, ret) = {
              match keys {
                [] => { ret!(acc) }
                [k ...rest] => {
                  new vCh in {
                    TreeHashMap!("get", map, k, *vCh) |
                    for (@v <- vCh) { fetchAll!(map, rest, acc ++ [v], *ret) }
                  }
                }
              }
            } |

            contract appendIndex(@map, @key, @item, ret) = {
              new lCh in {
                TreeHashMap!("get", map, key, *lCh) |
                for (@l <- lCh) {
                  match l {
                    Nil => { TreeHashMap!("set", map, key, [item], *ret) }
                    _ => { TreeHashMap!("set", map, key, l ++ [item], *ret) }
                  }
                }
              }
            } |

            contract isParticipant(@instanceId, @address, ret) = {
              new iCh in {
                TreeHashMap!("get", instances, instanceId, *iCh) |
                for (@inst <- iCh) {
                  match inst {
                    Nil => { ret!(false) }
                    _ => { ret!(inst.get("participants").contains(address)) }
                  }
                }
              }
            } |

            contract addParticipant(@instanceId, @address, @role, @ts, ret) = {
              new iCh, ack in {
                TreeHashMap!("get", instances, instanceId, *iCh) |
                for (@inst <- iCh) {
                  match inst {
                    Nil => { ret!(false) }
                    _ => {
                      if (inst.get("participants").contains(address)) { ret!(true) }
                      else {
                        TreeHashMap!("set", instances, instanceId,
                          inst.set("participants",
                            inst.get("participants").set(address, {"role": role, "joinedAt": ts})),
                          *ack) |
                        for (_ <- ack) { ret!(true) }
                      }
                    }
                  }
                }
              }
            } |

            // Move `amount` from the caller's vault to `to`.
            contract pull(@did, @from, @to, @amount, ret) = {
              new vCh, tCh, kCh in {
                @SystemVault!("findOrCreate", from, *vCh) |
                @SystemVault!("findOrCreate", to, *tCh) |
                @SystemVault!("deployerAuthKey", did, *kCh) |
                for (@(true, vault) <- vCh & key <- kCh & @(true, _) <- tCh) {
                  @vault!("transfer", to, amount, *key, *ret)
                }
              }
            } |

            // Pay `amount` to `to` from sponsorship `id`'s escrow vault.
            contract payFromEscrow(@id, @to, @amount, ret) = {
              new eCh, aCh, vCh, tCh, kCh in {
                TreeHashMap!("get", escrows, id, *eCh) |
                for (@escrow <- eCh) {
                  vaultAddress!("fromUnforgeable", escrow, *aCh) |
                  @SystemVault!("unforgeableAuthKey", escrow, *kCh) |
                  for (@from <- aCh) {
                    @SystemVault!("findOrCreate", from, *vCh) |
                    @SystemVault!("findOrCreate", to, *tCh) |
                    for (key <- kCh & @(true, vault) <- vCh & @(true, _) <- tCh) {
                      @vault!("transfer", to, amount, *key, *ret)
                    }
                  }
                }
              }
            } |

            // Pay sponsorship `id`'s stipend to `to` for playing `gameId`.
            contract payStipend(@id, @gameId, @to, ret) = {
              new sCh, hCh, pCh, ack in {
                TreeHashMap!("get", sponsors, id, *sCh) |
                height!(*hCh) |
                for (@s <- sCh & @n <- hCh) {
                  match s {
                    Nil => { ret!((false, "unknown sponsorship")) }
                    _ => {
                      match (s.get("terms"), s.get("claims").getOrElse(to, 0)) {
                        (terms, claimed) => {
                          if (s.get("status") != "active") { ret!((false, "sponsorship is not active")) }
                          else { if (n > terms.get("expiresAt")) { ret!((false, "sponsorship expired")) }
                          else { if (not (terms.get("games").size() == 0 or terms.get("games").contains(gameId))) { ret!((false, "game not sponsored")) }
                          else { if (claimed >= terms.get("maxPerAddress")) { ret!((false, "stipend already claimed")) }
                          else { if (s.get("funded") - s.get("paid") < terms.get("stipend")) { ret!((false, "sponsorship exhausted")) }
                          else {
                            payFromEscrow!(id, to, terms.get("stipend"), *pCh) |
                            for (@result <- pCh) {
                              match result {
                                (true, _) => {
                                  TreeHashMap!("set", sponsors, id,
                                    s.set("paid", s.get("paid") + terms.get("stipend"))
                                     .set("claims", s.get("claims").set(to, claimed + 1)),
                                    *ack) |
                                  for (_ <- ack) { ret!((true, terms.get("stipend"))) }
                                }
                                (false, err) => { ret!((false, err)) }
                              }
                            }
                          } } } } }
                        }
                      }
                    }
                  }
                }
              }
            } |

            // ---------------------------------------------------- profiles

            contract env(@"profiles", @"save", @profile, ret) = {
              new whoCh, ack in {
                who!(*whoCh) |
                for (@address, @ts, _ <- whoCh) {
                  TreeHashMap!("set", profiles, address,
                    profile.set("address", address).set("updatedAt", ts), *ack) |
                  for (_ <- ack) { ret!((true, address)) }
                }
              }
            } |

            contract env(@"profiles", @"get", @address, ret) = {
              new vCh in {
                TreeHashMap!("get", profiles, address, *vCh) |
                for (@v <- vCh) { ret!((true, v)) }
              }
            } |

            // ---------------------------------------------------- game registry
            // Governed by the F1R3FLY.io Cooperative's address.

            contract env(@"games", @"register", @manifest, ret) = {
              new whoCh, ack in {
                who!(*whoCh) |
                for (@address, @ts, _ <- whoCh) {
                  if (address != {{coop}}) { ret!((false, "only the F1R3FLY.io Cooperative may register games")) }
                  else {
                    TreeHashMap!("set", gameMap, manifest.get("id"),
                      manifest.set("status", "active").set("registeredAt", ts), *ack) |
                    for (_ <- ack) { ret!((true, manifest.get("id"))) }
                  }
                }
              }
            } |

            contract env(@"games", @"retire", @gameId, ret) = {
              new whoCh, gCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", gameMap, gameId, *gCh) |
                for (@address, _, _ <- whoCh & @game <- gCh) {
                  if (address != {{coop}}) { ret!((false, "only the F1R3FLY.io Cooperative may retire games")) }
                  else {
                    match game {
                      Nil => { ret!((false, "unknown game")) }
                      _ => {
                        TreeHashMap!("set", gameMap, gameId, game.set("status", "retired"), *ack) |
                        for (_ <- ack) { ret!((true, gameId)) }
                      }
                    }
                  }
                }
              }
            } |

            contract env(@"games", @"get", @gameId, ret) = {
              new gCh in {
                TreeHashMap!("get", gameMap, gameId, *gCh) |
                for (@g <- gCh) { ret!((true, g)) }
              }
            } |

            contract env(@"games", @"list", ret) = {
              new mCh in {
                TreeHashMap!("toMap", gameMap, *mCh) |
                for (@m <- mCh) { ret!((true, m)) }
              }
            } |

            // ---------------------------------------------------- instances

            contract env(@"instances", @"create", @id, @gameId, @visibility, @config, ret) = {
              new whoCh, gCh, eCh, ack, ack2 in {
                who!(*whoCh) |
                TreeHashMap!("get", gameMap, gameId, *gCh) |
                TreeHashMap!("get", instances, id, *eCh) |
                for (@host, @ts, _ <- whoCh & @game <- gCh & @existing <- eCh) {
                  if (game == Nil) { ret!((false, "unknown game")) }
                  else { if (game.get("status") != "active") { ret!((false, "game is retired")) }
                  else { if (existing != Nil) { ret!((false, "instance id in use")) }
                  else { if (not (visibility == "public" or visibility == "unlisted" or visibility == "private")) { ret!((false, "visibility must be public, unlisted or private")) }
                  else {
                    TreeHashMap!("set", instances, id, {
                      "id": id, "game": gameId, "host": host, "createdAt": ts,
                      "visibility": visibility, "status": "lobby", "config": config,
                      "participants": {host: {"role": "host", "joinedAt": ts}}
                    }, *ack) |
                    for (_ <- ack) {
                      if (visibility == "public") {
                        appendIndex!(gameIndex, gameId, id, *ack2) |
                        for (_ <- ack2) { ret!((true, id)) }
                      } else { ret!((true, id)) }
                    }
                  } } } }
                }
              }
            } |

            // Public and unlisted instances admit anyone who knows the id;
            // private instances admit only by invitation.
            contract env(@"instances", @"join", @id, ret) = {
              new whoCh, iCh, aCh in {
                who!(*whoCh) |
                TreeHashMap!("get", instances, id, *iCh) |
                for (@address, @ts, _ <- whoCh & @inst <- iCh) {
                  if (inst == Nil) { ret!((false, "unknown instance")) }
                  else { if (inst.get("status") == "closed") { ret!((false, "instance is closed")) }
                  else { if (inst.get("visibility") == "private" and not inst.get("participants").contains(address)) { ret!((false, "private instance: an invitation is required")) }
                  else {
                    addParticipant!(id, address, "player", ts, *aCh) |
                    for (@ok <- aCh) { ret!((ok, id)) }
                  } } }
                }
              }
            } |

            contract env(@"instances", @"leave", @id, ret) = {
              new whoCh, iCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", instances, id, *iCh) |
                for (@address, _, _ <- whoCh & @inst <- iCh) {
                  if (inst == Nil) { ret!((false, "unknown instance")) }
                  else { if (inst.get("host") == address) { ret!((false, "the host cannot leave; close the instance instead")) }
                  else {
                    TreeHashMap!("set", instances, id,
                      inst.set("participants", inst.get("participants").delete(address)), *ack) |
                    for (_ <- ack) { ret!((true, id)) }
                  } }
                }
              }
            } |

            contract env(@"instances", @"setStatus", @id, @status, ret) = {
              new whoCh, iCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", instances, id, *iCh) |
                for (@address, _, _ <- whoCh & @inst <- iCh) {
                  if (inst == Nil) { ret!((false, "unknown instance")) }
                  else { if (inst.get("host") != address) { ret!((false, "only the host may change status")) }
                  else { if (not (status == "lobby" or status == "active" or status == "closed")) { ret!((false, "status must be lobby, active or closed")) }
                  else {
                    TreeHashMap!("set", instances, id, inst.set("status", status), *ack) |
                    for (_ <- ack) { ret!((true, status)) }
                  } } }
                }
              }
            } |

            contract env(@"instances", @"get", @id, ret) = {
              new iCh in {
                TreeHashMap!("get", instances, id, *iCh) |
                for (@inst <- iCh) { ret!((true, inst)) }
              }
            } |

            contract env(@"instances", @"listPublic", @gameId, ret) = {
              new lCh, fCh in {
                TreeHashMap!("get", gameIndex, gameId, *lCh) |
                for (@ids <- lCh) {
                  match ids {
                    Nil => { ret!((true, [])) }
                    _ => {
                      fetchAll!(instances, ids, [], *fCh) |
                      for (@all <- fCh) { ret!((true, all)) }
                    }
                  }
                }
              }
            } |

            // ---------------------------------------------------- plays (gallery)
            // Bodies are kept on chain, by version.

            contract env(@"plays", @"publish", @id, @instanceId, @kind, @header, @body, ret) = {
              new whoCh, iCh, eCh, hCh, ack1, ack2, ack3 in {
                who!(*whoCh) |
                TreeHashMap!("get", instances, instanceId, *iCh) |
                TreeHashMap!("get", plays, id, *eCh) |
                for (@author, @ts, _ <- whoCh & @inst <- iCh & @existing <- eCh) {
                  if (inst == Nil) { ret!((false, "unknown instance")) }
                  else { if (existing != Nil) { ret!((false, "play id in use")) }
                  else { if (not inst.get("participants").contains(author)) { ret!((false, "only participants may publish")) }
                  else {
                    blake2b!(body, *hCh) |
                    for (@bodyHash <- hCh) {
                      TreeHashMap!("set", plays, id,
                        header.set("id", id).set("game", inst.get("game")).set("kind", kind)
                              .set("instance", instanceId).set("authors", [author])
                              .set("createdAt", ts).set("bodyHash", bodyHash)
                              .set("version", 0).set("links", []),
                        *ack1) |
                      TreeHashMap!("set", bodies, (id, 0), body, *ack2) |
                      appendIndex!(playIndex, (inst.get("game"), kind, ts / 86400000), id, *ack3) |
                      for (_ <- ack1 & _ <- ack2 & _ <- ack3) { ret!((true, id)) }
                    }
                  } } }
                }
              }
            } |

            contract env(@"plays", @"saveVersion", @id, @body, ret) = {
              new whoCh, pCh, hCh, ack1, ack2 in {
                who!(*whoCh) |
                TreeHashMap!("get", plays, id, *pCh) |
                for (@author, _, _ <- whoCh & @play <- pCh) {
                  if (play == Nil) { ret!((false, "unknown play")) }
                  else { if (not play.get("authors").toSet().contains(author)) { ret!((false, "only an author may save a version")) }
                  else {
                    blake2b!(body, *hCh) |
                    for (@bodyHash <- hCh) {
                      match play.get("version") + 1 {
                        v => {
                          TreeHashMap!("set", bodies, (id, v), body, *ack1) |
                          TreeHashMap!("set", plays, id, play.set("version", v).set("bodyHash", bodyHash), *ack2) |
                          for (_ <- ack1 & _ <- ack2) { ret!((true, v)) }
                        }
                      }
                    }
                  } }
                }
              }
            } |

            contract env(@"plays", @"link", @id, @other, ret) = {
              new whoCh, pCh, oCh, ack1, ack2 in {
                who!(*whoCh) |
                TreeHashMap!("get", plays, id, *pCh) |
                TreeHashMap!("get", plays, other, *oCh) |
                for (@author, _, _ <- whoCh & @play <- pCh & @otherPlay <- oCh) {
                  if (play == Nil or otherPlay == Nil) { ret!((false, "unknown play")) }
                  else { if (not play.get("authors").toSet().contains(author)) { ret!((false, "only an author may link a play")) }
                  else {
                    TreeHashMap!("set", plays, id, play.set("links", play.get("links") ++ [other]), *ack1) |
                    TreeHashMap!("set", plays, other, otherPlay.set("links", otherPlay.get("links") ++ [id]), *ack2) |
                    for (_ <- ack1 & _ <- ack2) { ret!((true, [id, other])) }
                  } }
                }
              }
            } |

            contract env(@"plays", @"get", @id, ret) = {
              new pCh in {
                TreeHashMap!("get", plays, id, *pCh) |
                for (@p <- pCh) { ret!((true, p)) }
              }
            } |

            // version -1 means the latest
            contract env(@"plays", @"body", @id, @version, ret) = {
              new pCh, bCh in {
                TreeHashMap!("get", plays, id, *pCh) |
                for (@p <- pCh) {
                  match p {
                    Nil => { ret!((false, "unknown play")) }
                    _ => {
                      {
                        if (version == -1) { TreeHashMap!("get", bodies, (id, p.get("version")), *bCh) }
                        else { TreeHashMap!("get", bodies, (id, version), *bCh) }
                      } |
                      for (@b <- bCh) { ret!((true, b)) }
                    }
                  }
                }
              }
            } |

            contract env(@"plays", @"list", @gameId, @kind, @day, ret) = {
              new lCh, fCh in {
                TreeHashMap!("get", playIndex, (gameId, kind, day), *lCh) |
                for (@ids <- lCh) {
                  match ids {
                    Nil => { ret!((true, [])) }
                    _ => {
                      fetchAll!(plays, ids, [], *fCh) |
                      for (@all <- fCh) { ret!((true, all)) }
                    }
                  }
                }
              }
            } |

            // ---------------------------------------------------- invitations

            contract env(@"invites", @"issue", @invitePk, @instanceId, @uses, @expiresAt, @sponsorship, ret) = {
              new whoCh, pCh, eCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", invites, invitePk, *eCh) |
                for (@issuer, @ts, _ <- whoCh & @existing <- eCh) {
                  isParticipant!(instanceId, issuer, *pCh) |
                  for (@isIn <- pCh) {
                    if (not isIn) { ret!((false, "only participants may invite")) }
                    else { if (existing != Nil) { ret!((false, "invitation key already used")) }
                    else { if (uses < 1) { ret!((false, "uses must be at least 1")) }
                    else { if (invitePk.length() != 65) { ret!((false, "invite key must be 65 bytes")) }
                    else {
                      TreeHashMap!("set", invites, invitePk, {
                        "instance": instanceId, "issuer": issuer, "issuedAt": ts,
                        "uses": uses, "expiresAt": expiresAt, "sponsorship": sponsorship,
                        "redeemed": Set(), "revoked": false
                      }, *ack) |
                      for (_ <- ack) { ret!((true, instanceId)) }
                    } } } }
                  }
                }
              }
            } |

            contract env(@"invites", @"redeem", @invitePk, @sig, ret) = {
              new whoCh, invCh, hCh, nCh, digestCh, validCh, partCh, ack, iCh, stipendCh in {
                who!(*whoCh) |
                TreeHashMap!("get", invites, invitePk, *invCh) |
                height!(*nCh) |
                for (@guest, @ts, _ <- whoCh & @inv <- invCh & @n <- nCh) {
                  if (inv == Nil) { ret!((false, "unknown invitation")) }
                  else { if (inv.get("revoked")) { ret!((false, "invitation revoked")) }
                  else { if (n > inv.get("expiresAt")) { ret!((false, "invitation expired")) }
                  else { if (inv.get("uses") < 1) { ret!((false, "invitation used up")) }
                  else { if (inv.get("redeemed").contains(guest)) { ret!((false, "already redeemed by this address")) }
                  else {
                    blake2b!(("f1r3games:redeem:v1:" ++ invitePk.bytesToHex() ++ ":" ++ guest).toUtf8Bytes(), *digestCh) |
                    for (@digest <- digestCh) {
                      secpVerify!(digest, sig, invitePk, *validCh) |
                      for (@valid <- validCh) {
                        if (not valid) { ret!((false, "bad invitation signature")) }
                        else {
                          TreeHashMap!("set", invites, invitePk,
                            inv.set("uses", inv.get("uses") - 1)
                               .set("redeemed", inv.get("redeemed").add(guest)),
                            *ack) |
                          addParticipant!(inv.get("instance"), guest, "player", ts, *partCh) |
                          TreeHashMap!("get", instances, inv.get("instance"), *iCh) |
                          for (_ <- ack & @joined <- partCh & @inst <- iCh) {
                            match inv.get("sponsorship") {
                              Nil => { ret!((joined, {"instance": inv.get("instance"), "stipend": 0})) }
                              sid => {
                                payStipend!(sid, inst.get("game"), guest, *stipendCh) |
                                for (@paid <- stipendCh) {
                                  match paid {
                                    (true, amount) => { ret!((joined, {"instance": inv.get("instance"), "stipend": amount})) }
                                    (false, why) => { ret!((joined, {"instance": inv.get("instance"), "stipend": 0, "stipendRefused": why})) }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  } } } } }
                }
              }
            } |

            contract env(@"invites", @"revoke", @invitePk, ret) = {
              new whoCh, invCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", invites, invitePk, *invCh) |
                for (@address, _, _ <- whoCh & @inv <- invCh) {
                  if (inv == Nil) { ret!((false, "unknown invitation")) }
                  else { if (inv.get("issuer") != address) { ret!((false, "only the issuer may revoke")) }
                  else {
                    TreeHashMap!("set", invites, invitePk, inv.set("revoked", true), *ack) |
                    for (_ <- ack) { ret!((true, true)) }
                  } }
                }
              }
            } |

            contract env(@"invites", @"get", @invitePk, ret) = {
              new invCh in {
                TreeHashMap!("get", invites, invitePk, *invCh) |
                for (@inv <- invCh) { ret!((true, inv)) }
              }
            } |

            // ---------------------------------------------------- sponsorships
            // A sponsor (an advertiser, a studio, an inviter, any stakeholder)
            // funds an escrow vault held by this environment. Players claim a
            // stipend from it on joining a sponsored game or on redeeming an
            // invitation that names it. terms: {"name", "message", "link",
            // "creative" (bytes), "games" (Set of game ids; empty = any),
            // "stipend", "maxPerAddress", "expiresAt" (block height)}.

            contract env(@"sponsors", @"create", @id, @terms, @amount, ret) = {
              new whoCh, eCh, escrow, aCh, tCh, ack1, ack2, ack3 in {
                who!(*whoCh) |
                TreeHashMap!("get", sponsors, id, *eCh) |
                for (@sponsor, @ts, @did <- whoCh & @existing <- eCh) {
                  if (existing != Nil) { ret!((false, "sponsorship id in use")) }
                  else { if (amount < 1 or terms.get("stipend") < 1 or terms.get("maxPerAddress") < 1) { ret!((false, "amount, stipend and maxPerAddress must be positive")) }
                  else {
                    vaultAddress!("fromUnforgeable", *escrow, *aCh) |
                    for (@escrowAddress <- aCh) {
                      pull!(did, sponsor, escrowAddress, amount, *tCh) |
                      for (@moved <- tCh) {
                        match moved {
                          (true, _) => {
                            TreeHashMap!("set", escrows, id, *escrow, *ack1) |
                            TreeHashMap!("set", sponsors, id, {
                              "id": id, "sponsor": sponsor, "createdAt": ts, "terms": terms,
                              "escrow": escrowAddress, "funded": amount, "paid": 0,
                              "claims": {}, "status": "active"
                            }, *ack2) |
                            appendIndex!(sponsorIndex, "all", id, *ack3) |
                            for (_ <- ack1 & _ <- ack2 & _ <- ack3) { ret!((true, {"id": id, "escrow": escrowAddress})) }
                          }
                          (false, err) => { ret!((false, err)) }
                        }
                      }
                    }
                  } }
                }
              }
            } |

            contract env(@"sponsors", @"fund", @id, @amount, ret) = {
              new whoCh, sCh, tCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", sponsors, id, *sCh) |
                for (@funder, _, @did <- whoCh & @s <- sCh) {
                  if (s == Nil) { ret!((false, "unknown sponsorship")) }
                  else { if (amount < 1) { ret!((false, "amount must be positive")) }
                  else {
                    pull!(did, funder, s.get("escrow"), amount, *tCh) |
                    for (@moved <- tCh) {
                      match moved {
                        (true, _) => {
                          TreeHashMap!("set", sponsors, id, s.set("funded", s.get("funded") + amount), *ack) |
                          for (_ <- ack) { ret!((true, s.get("funded") + amount)) }
                        }
                        (false, err) => { ret!((false, err)) }
                      }
                    }
                  } }
                }
              }
            } |

            contract env(@"sponsors", @"claim", @id, @instanceId, ret) = {
              new whoCh, iCh, pCh in {
                who!(*whoCh) |
                TreeHashMap!("get", instances, instanceId, *iCh) |
                for (@player, _, _ <- whoCh & @inst <- iCh) {
                  if (inst == Nil) { ret!((false, "unknown instance")) }
                  else { if (not inst.get("participants").contains(player)) { ret!((false, "join the instance first")) }
                  else {
                    payStipend!(id, inst.get("game"), player, *pCh) |
                    for (@result <- pCh) { ret!(result) }
                  } }
                }
              }
            } |

            contract env(@"sponsors", @"withdraw", @id, ret) = {
              new whoCh, sCh, hCh, pCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", sponsors, id, *sCh) |
                height!(*hCh) |
                for (@address, _, _ <- whoCh & @s <- sCh & @n <- hCh) {
                  if (s == Nil) { ret!((false, "unknown sponsorship")) }
                  else { if (s.get("sponsor") != address) { ret!((false, "only the sponsor may withdraw")) }
                  else { if (n <= s.get("terms").get("expiresAt")) { ret!((false, "the sponsorship has not expired")) }
                  else {
                    match s.get("funded") - s.get("paid") {
                      remaining => {
                        if (remaining < 1) {
                          TreeHashMap!("set", sponsors, id, s.set("status", "closed"), *ack) |
                          for (_ <- ack) { ret!((true, 0)) }
                        } else {
                          payFromEscrow!(id, address, remaining, *pCh) |
                          for (@result <- pCh) {
                            match result {
                              (true, _) => {
                                TreeHashMap!("set", sponsors, id, s.set("status", "closed").set("paid", s.get("funded")), *ack) |
                                for (_ <- ack) { ret!((true, remaining)) }
                              }
                              (false, err) => { ret!((false, err)) }
                            }
                          }
                        }
                      }
                    }
                  } } }
                }
              }
            } |

            contract env(@"sponsors", @"get", @id, ret) = {
              new sCh in {
                TreeHashMap!("get", sponsors, id, *sCh) |
                for (@s <- sCh) { ret!((true, s)) }
              }
            } |

            contract env(@"sponsors", @"list", ret) = {
              new lCh, fCh in {
                TreeHashMap!("get", sponsorIndex, "all", *lCh) |
                for (@ids <- lCh) {
                  match ids {
                    Nil => { ret!((true, [])) }
                    _ => {
                      fetchAll!(sponsors, ids, [], *fCh) |
                      for (@all <- fCh) { ret!((true, all)) }
                    }
                  }
                }
              }
            } |

            // ---------------------------------------------------- engagement
            // One count per (play, kind, address).

            contract env(@"engagement", @"record", @playId, @kind, ret) = {
              new whoCh, sCh, cCh, ack1, ack2 in {
                who!(*whoCh) |
                for (@address, _, _ <- whoCh) {
                  TreeHashMap!("get", seen, (playId, kind, address), *sCh) |
                  TreeHashMap!("get", counts, playId, *cCh) |
                  for (@already <- sCh & @c <- cCh) {
                    if (already != Nil) { ret!((true, false)) }
                    else {
                      match c {
                        Nil => { TreeHashMap!("set", counts, playId, {kind: 1}, *ack1) }
                        _ => { TreeHashMap!("set", counts, playId, c.set(kind, c.getOrElse(kind, 0) + 1), *ack1) }
                      } |
                      TreeHashMap!("set", seen, (playId, kind, address), true, *ack2) |
                      for (_ <- ack1 & _ <- ack2) { ret!((true, true)) }
                    }
                  }
                }
              }
            } |

            contract env(@"engagement", @"counts", @playId, ret) = {
              new cCh in {
                TreeHashMap!("get", counts, playId, *cCh) |
                for (@c <- cCh) {
                  match c {
                    Nil => { ret!((true, {})) }
                    _ => { ret!((true, c)) }
                  }
                }
              }
            } |

            // ---------------------------------------------------- contacts backup
            // Ciphertext only; the key never leaves the person's device.

            contract env(@"contacts", @"save", @ciphertext, ret) = {
              new whoCh, ack in {
                who!(*whoCh) |
                for (@address, @ts, _ <- whoCh) {
                  TreeHashMap!("set", contacts, address, {"ciphertext": ciphertext, "updatedAt": ts}, *ack) |
                  for (_ <- ack) { ret!((true, ts)) }
                }
              }
            } |

            // ---------------------------------------------------- payments
            // Payments between the participants of an instance (F1R3Pix design §7).
            // The caller's funds move through `pull`, and the record of each
            // transfer is kept under (instance, payer), which only the payer writes.

            // "" when every transfer is [participant other than payer, positive Int]
            // and the recipients are distinct; otherwise the reason.
            contract validTransfers(@transfers, @participants, @payer, @seen, ret) = {
              match transfers {
                [] => { ret!("") }
                [[to /\ String, amount /\ Int] ...rest] => {
                  if (not participants.contains(to)) { ret!("every recipient must be a participant") }
                  else { if (to == payer) { ret!("you cannot pay yourself") }
                  else { if (seen.contains(to)) { ret!("recipients must be distinct") }
                  else { if (amount < 1) { ret!("amounts must be positive") }
                  else { validTransfers!(rest, participants, payer, seen.add(to), *ret) } } } }
                }
                _ => { ret!("transfers must be [address, amount] pairs") }
              }
            } |

            contract payEach(@did, @payer, @instanceId, @transfers, @memo, @ts, @h, @results, ret) = {
              match transfers {
                [] => { ret!((true, results)) }
                [[to, amount] ...rest] => {
                  new tCh, lCh, recCh, ack in {
                    pull!(did, payer, to, amount, *tCh) |
                    for (@moved <- tCh) {
                      TreeHashMap!("get", payments, (instanceId, payer), *lCh) |
                      for (@l <- lCh) {
                        match l { Nil => { recCh!([]) } _ => { recCh!(l) } } |
                        for (@list <- recCh) {
                          match moved {
                            (true, _) => {
                              TreeHashMap!("set", payments, (instanceId, payer),
                                list ++ [{"seq": list.length(), "to": to, "amount": amount, "ok": true, "reason": "",
                                          "at": ts, "h": h, "memo": memo}], *ack) |
                              for (_ <- ack) {
                                payEach!(did, payer, instanceId, rest, memo, ts, h,
                                  results ++ [{"to": to, "amount": amount, "ok": true}], *ret)
                              }
                            }
                            (false, err) => {
                              TreeHashMap!("set", payments, (instanceId, payer),
                                list ++ [{"seq": list.length(), "to": to, "amount": amount, "ok": false, "reason": err,
                                          "at": ts, "h": h, "memo": memo}], *ack) |
                              for (_ <- ack) {
                                payEach!(did, payer, instanceId, rest, memo, ts, h,
                                  results ++ [{"to": to, "amount": amount, "ok": false, "reason": err}], *ret)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            } |

            contract env(@"payments", @"send", @instanceId, @transfers, @memo, ret) = {
              new whoCh, iCh, vCh, hCh, ack in {
                who!(*whoCh) |
                TreeHashMap!("get", instances, instanceId, *iCh) |
                for (@payer, @ts, @did <- whoCh & @inst <- iCh) {
                  if (inst == Nil) { ret!((false, "unknown instance")) }
                  else { if (inst.get("status") == "closed") { ret!((false, "instance is closed")) }
                  else { if (not inst.get("participants").contains(payer)) { ret!((false, "join the instance first")) }
                  else {
                    match [transfers, memo] {
                      [ts1 /\ List, Nil] => { vCh!(ts1.length() >= 1 and ts1.length() <= 64) }
                      [ts1 /\ List, m /\ String] => { vCh!(ts1.length() >= 1 and ts1.length() <= 64 and m.length() <= 140) }
                      _ => { vCh!(false) }
                    } |
                    for (@shapeOk <- vCh) {
                      if (not shapeOk) { ret!((false, "1 to 64 transfers, and a memo of at most 140 characters")) }
                      else {
                        new whyCh in {
                          validTransfers!(transfers, inst.get("participants"), payer, Set(), *whyCh) |
                          for (@why <- whyCh) {
                            if (why != "") { ret!((false, why)) }
                            else {
                              height!(*hCh) |
                              for (@h <- hCh) { payEach!(did, payer, instanceId, transfers, memo, ts, h, [], *ret) }
                            }
                          }
                        }
                      }
                    }
                  } } }
                }
              }
            } |

            contract paymentsFrom(@instanceId, @payers, @cursor, @acc, ret) = {
              match payers {
                [] => { ret!(acc) }
                [p ...rest] => {
                  new lCh, fCh in {
                    TreeHashMap!("get", payments, (instanceId, p), *lCh) |
                    for (@l <- lCh) {
                      match l {
                        Nil => { paymentsFrom!(instanceId, rest, cursor, acc, *ret) }
                        _ => {
                          new filter in {
                            contract filter(@xs, @acc2) = {
                              match xs {
                                [] => { paymentsFrom!(instanceId, rest, cursor, acc2, *ret) }
                                [x ...more] => {
                                  if (x.get("seq") > cursor.getOrElse(p, -1)) { filter!(more, acc2 ++ [x.set("from", p)]) }
                                  else { filter!(more, acc2) }
                                }
                              }
                            } |
                            filter!(l, acc)
                          }
                        }
                      }
                    }
                  }
                }
              }
            } |

            // Every payment within the instance after `cursor` (payer -> last seq seen).
            contract env(@"payments", @"list", @instanceId, @cursor, ret) = {
              new iCh, pCh in {
                TreeHashMap!("get", instances, instanceId, *iCh) |
                for (@inst <- iCh) {
                  if (inst == Nil) { ret!((false, "unknown instance")) }
                  else {
                    match cursor {
                      c /\ Map => { paymentsFrom!(instanceId, inst.get("participants").keys().toList(), c, [], *pCh) }
                      _ => { paymentsFrom!(instanceId, inst.get("participants").keys().toList(), {}, [], *pCh) }
                    } |
                    for (@l <- pCh) { ret!((true, l)) }
                  }
                }
              }
            } |

            contract env(@"contacts", @"delete", ret) = {
              new whoCh, ack in {
                who!(*whoCh) |
                for (@address, _, _ <- whoCh) {
                  TreeHashMap!("delete", contacts, address, *ack) |
                  for (_ <- ack) { ret!((true, true)) }
                }
              }
            } |

            contract env(@"contacts", @"get", @address, ret) = {
              new cCh in {
                TreeHashMap!("get", contacts, address, *cCh) |
                for (@c <- cCh) { ret!((true, c)) }
              }
            }
          }
        }
      }
    } |

    rs!({{public_key}}, ({{version}}, bundle+{*env}), {{sig}}, *uriCh) |
    for (@uri <- uriCh) {
      match uri {
        Nil => { abort!("failed to insert the f1r3games environment") }
        _ => { stdout!(("f1r3games environment registered", uri)) }
      }
    }
  }
}
